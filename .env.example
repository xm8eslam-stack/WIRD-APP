# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WIRD CANONICAL FIREBASE PROJECT
# Project: wird-quran-app
# Firestore database: (default) — do not set VITE_FIREBASE_FIRESTORE_DATABASE_ID.
# Configure the same Firebase Web App values in Google AI Studio and Vercel.
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="wird-quran-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="wird-quran-app"
VITE_FIREBASE_STORAGE_BUCKET="wird-quran-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="741238306826"
VITE_FIREBASE_APP_ID="1:741238306826:web:3db91a75a7b7dc5dae07f3"
