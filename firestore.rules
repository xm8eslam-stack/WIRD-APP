rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function ownsUserPath(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAllowedCollection(collection) {
      return collection in [
        'profile', 'plans', 'enginePlans', 'portions',
        'weakVerses', 'tests', 'activityEvents', 'syncMeta'
      ];
    }

    function hasValidSyncEnvelope() {
      let data = request.resource.data;
      return data.keys().hasAll(['schemaVersion', 'payload', 'updatedAtMs', 'deviceId', 'mutationId'])
        && data.keys().hasOnly(['schemaVersion', 'payload', 'updatedAtMs', 'deviceId', 'mutationId', 'deletedAt'])
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.payload is map
        && data.updatedAtMs is int
        && data.updatedAtMs >= 0
        && data.deviceId is string
        && data.deviceId.size() > 0
        && data.deviceId.size() <= 128
        && data.mutationId is string
        && data.mutationId.size() > 0
        && data.mutationId.size() <= 128
        && (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt is timestamp);
    }

    function hasValidJournalEnvelope() {
      return request.resource.data.payload.journalEvent is map
        && request.resource.data.payload.journalEvent.keys().hasAll([
          'schemaVersion', 'collection', 'documentId', 'operation',
          'clientUpdatedAtMs', 'createdAtMs', 'fingerprint', 'payload', 'serverCreatedAt'
        ])
        && request.resource.data.payload.journalEvent.keys().hasOnly([
          'schemaVersion', 'collection', 'documentId', 'operation',
          'clientUpdatedAtMs', 'createdAtMs', 'fingerprint', 'payload', 'serverCreatedAt'
        ])
        && request.resource.data.payload.journalEvent.schemaVersion is int
        && request.resource.data.payload.journalEvent.schemaVersion == 1
        && request.resource.data.payload.journalEvent.collection in [
          'profile', 'plans', 'enginePlans', 'portions',
          'weakVerses', 'tests', 'activityEvents', 'syncMeta'
        ]
        && request.resource.data.payload.journalEvent.documentId is string
        && request.resource.data.payload.journalEvent.documentId.size() > 0
        && request.resource.data.payload.journalEvent.documentId.size() <= 1500
        && request.resource.data.payload.journalEvent.operation in ['upsert', 'tombstone']
        && request.resource.data.payload.journalEvent.clientUpdatedAtMs is int
        && request.resource.data.payload.journalEvent.clientUpdatedAtMs >= 0
        && request.resource.data.payload.journalEvent.createdAtMs is int
        && request.resource.data.payload.journalEvent.createdAtMs >= 0
        && request.resource.data.payload.journalEvent.fingerprint is string
        && request.resource.data.payload.journalEvent.fingerprint.size() == 16
        && request.resource.data.payload.journalEvent.payload is map
        && request.resource.data.payload.journalEvent.serverCreatedAt == request.time;
    }

    function hasValidDomainEvent(uid, eventId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schemaVersion', 'eventId', 'mutationId', 'uid',
          'deviceId', 'occurredAtMs', 'eventType', 'payload'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'eventId', 'mutationId', 'uid',
          'deviceId', 'occurredAtMs', 'eventType', 'payload'
        ])
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.eventId == eventId
        && data.eventId is string
        && data.eventId.size() > 0
        && data.eventId.size() <= 128
        && data.mutationId is string
        && data.mutationId.size() > 0
        && data.mutationId.size() <= 128
        && data.uid == uid
        && data.deviceId is string
        && data.deviceId.size() > 0
        && data.deviceId.size() <= 128
        && data.occurredAtMs is int
        && data.occurredAtMs >= 0
        && data.eventType is string
        && data.eventType.size() > 0
        && data.eventType.size() <= 64
        && data.payload is map
        && (data.eventType != 'domain-mutation.v2' || hasValidJournalEnvelope());
    }

    match /users/{uid}/events/{eventId} {
      allow read: if ownsUserPath(uid);
      allow create: if ownsUserPath(uid) && hasValidDomainEvent(uid, eventId);
      allow update, delete: if false;
    }

    match /users/{uid}/{collection}/{documentId} {
      allow read: if ownsUserPath(uid) && isAllowedCollection(collection);
      allow create, update: if ownsUserPath(uid)
        && isAllowedCollection(collection)
        && hasValidSyncEnvelope();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
