rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function ownsUserPath(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isAllowedCollection(collection) {
      return collection in [
        'profile',
        'plans',
        'enginePlans',
        'portions',
        'weakVerses',
        'tests',
        'activityEvents',
        'syncMeta'
      ];
    }

    function hasValidSyncEnvelope() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schemaVersion',
          'payload',
          'updatedAtMs',
          'deviceId',
          'mutationId',
          'baseRevision',
          'revision'
        ])
        && data.keys().hasOnly([
          'schemaVersion',
          'payload',
          'updatedAtMs',
          'deviceId',
          'mutationId',
          'baseRevision',
          'revision',
          'deletedAt'
        ])
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.payload is map
        && data.updatedAtMs is int
        && data.updatedAtMs >= 0
        && data.deviceId is string
        && data.deviceId.size() > 0
        && data.deviceId.size() <= 128
        && data.mutationId is string
        && data.mutationId.size() > 0
        && data.mutationId.size() <= 128
        && data.baseRevision is int
        && data.baseRevision >= 0
        && data.revision is int
        && data.revision > 0
        && data.revision == data.baseRevision + 1
        && (
          !('deletedAt' in data)
          || data.deletedAt == null
          || data.deletedAt is timestamp
        );
    }

    function hasMatchingSequenceAfter(uid, eventId) {
      let sequencePath = /databases/$(database)/documents/users/$(uid)/syncSystem/remoteReplication;
      return existsAfter(sequencePath)
        && getAfter(sequencePath).data.sequence == request.resource.data.serverSequence
        && getAfter(sequencePath).data.lastEventId == eventId
        && getAfter(sequencePath).data.mutationId == request.resource.data.mutationId;
    }

    function hasMatchingStateAfter(uid) {
      let statePath = /databases/$(database)/documents/users/$(uid)/$(request.resource.data.collection)/$(request.resource.data.documentId);
      return existsAfter(statePath)
        && getAfter(statePath).data.mutationId == request.resource.data.mutationId
        && getAfter(statePath).data.baseRevision == request.resource.data.baseRevision
        && getAfter(statePath).data.revision == request.resource.data.revision;
    }

    function hasMatchingEventAfter(uid) {
      let eventPath = /databases/$(database)/documents/users/$(uid)/events/$(request.resource.data.mutationId);
      return existsAfter(eventPath)
        && getAfter(eventPath).data.mutationId == request.resource.data.mutationId
        && getAfter(eventPath).data.serverSequence is int;
    }

    function hasMatchingSequenceEventAfter(uid) {
      let eventPath = /databases/$(database)/documents/users/$(uid)/events/$(request.resource.data.lastEventId);
      return existsAfter(eventPath)
        && getAfter(eventPath).data.mutationId == request.resource.data.mutationId
        && getAfter(eventPath).data.serverSequence == request.resource.data.sequence;
    }

    function hasValidDomainEvent(uid, eventId) {
      let data = request.resource.data;
      let common = data.keys().hasAll([
          'schemaVersion',
          'eventId',
          'mutationId',
          'uid',
          'deviceId',
          'occurredAtMs',
          'eventType',
          'payload'
        ])
        && data.eventId == eventId
        && data.eventId is string
        && data.eventId.size() > 0
        && data.eventId.size() <= 128
        && data.mutationId is string
        && data.mutationId.size() > 0
        && data.mutationId.size() <= 128
        && data.uid == uid
        && data.deviceId is string
        && data.deviceId.size() > 0
        && data.deviceId.size() <= 128
        && data.occurredAtMs is int
        && data.occurredAtMs >= 0
        && data.eventType is string
        && data.eventType.size() > 0
        && data.eventType.size() <= 64
        && data.payload is map;
      return common && (
        (
          data.schemaVersion == 1
          && data.keys().hasOnly([
            'schemaVersion', 'eventId', 'mutationId', 'uid', 'deviceId',
            'occurredAtMs', 'eventType', 'payload'
          ])
        )
        ||
        (
          data.schemaVersion == 2
          && data.keys().hasAll([
            'collection', 'documentId', 'operation', 'baseRevision',
            'revision', 'serverSequence'
          ])
          && data.keys().hasOnly([
            'schemaVersion', 'eventId', 'mutationId', 'uid', 'deviceId',
            'occurredAtMs', 'eventType', 'payload', 'collection',
            'documentId', 'operation', 'baseRevision', 'revision',
            'serverSequence'
          ])
          && isAllowedCollection(data.collection)
          && data.documentId is string
          && data.documentId.size() > 0
          && data.documentId.size() <= 1500
          && !data.documentId.matches('.*[/].*')
          && data.operation in ['upsert', 'tombstone']
          && data.baseRevision is int
          && data.baseRevision >= 0
          && data.revision is int
          && data.revision == data.baseRevision + 1
          && data.serverSequence is int
          && data.serverSequence > 0
          && hasMatchingSequenceAfter(uid, eventId)
          && hasMatchingStateAfter(uid)
        )
      );
    }

    function hasValidRemoteSequence() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'schemaVersion', 'sequence', 'baseSequence', 'lastEventId',
          'updatedAtMs', 'deviceId', 'mutationId'
        ])
        && data.keys().hasOnly([
          'schemaVersion', 'sequence', 'baseSequence', 'lastEventId',
          'updatedAtMs', 'deviceId', 'mutationId'
        ])
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.sequence is int
        && data.sequence > 0
        && data.baseSequence is int
        && data.baseSequence >= 0
        && data.sequence == data.baseSequence + 1
        && data.lastEventId is string
        && data.lastEventId.size() > 0
        && data.lastEventId.size() <= 128
        && data.updatedAtMs is int
        && data.updatedAtMs >= 0
        && data.deviceId is string
        && data.deviceId.size() > 0
        && data.deviceId.size() <= 128
        && data.mutationId is string
        && data.mutationId.size() > 0
        && data.mutationId.size() <= 128;
    }

    // Append-only immutable remote event ledger
    match /users/{uid}/events/{eventId} {
      allow read: if ownsUserPath(uid);
      allow create: if ownsUserPath(uid) && hasValidDomainEvent(uid, eventId);
      allow update, delete: if false;
    }

    // Only verified users may access allowlisted documents inside their own UID path.
    match /users/{uid}/{collection}/{documentId} {
      allow read: if ownsUserPath(uid) && isAllowedCollection(collection);
      allow create: if ownsUserPath(uid)
        && isAllowedCollection(collection)
        && hasValidSyncEnvelope()
        && request.resource.data.baseRevision == 0
        && request.resource.data.revision == 1
        && hasMatchingEventAfter(uid);
      // A revisioned update must prove the exact server version it replaced.
      // Legacy documents without a revision stay read-only until reconciled.
      allow update: if ownsUserPath(uid)
        && isAllowedCollection(collection)
        && hasValidSyncEnvelope()
        && resource.data.revision is int
        && request.resource.data.baseRevision == resource.data.revision
        && request.resource.data.revision == resource.data.revision + 1
        && hasMatchingEventAfter(uid);
      // Deletions are represented by tombstones to prevent offline resurrection.
      allow delete: if false;
    }

    match /users/{uid}/syncSystem/remoteReplication {
      allow read: if ownsUserPath(uid);
      allow create: if ownsUserPath(uid)
        && hasValidRemoteSequence()
        && request.resource.data.baseSequence == 0
        && request.resource.data.sequence == 1
        && hasMatchingSequenceEventAfter(uid);
      allow update: if ownsUserPath(uid)
        && hasValidRemoteSequence()
        && resource.data.sequence is int
        && request.resource.data.baseSequence == resource.data.sequence
        && request.resource.data.sequence == resource.data.sequence + 1
        && hasMatchingSequenceEventAfter(uid);
      allow delete: if false;
    }

    // Default deny: no public documents, admin bypasses, or unknown collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

