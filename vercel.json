{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/api/advisor/(.*)",
      "destination": "/api/advisor"
    },
    {
      "source": "/api/advisor",
      "destination": "/api/advisor"
    },
    {
      "source": "/api/tafsir/(.*)",
      "destination": "/api/tafsir"
    },
    {
      "source": "/api/tafsir",
      "destination": "/api/tafsir"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
